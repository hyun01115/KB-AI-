# ==============================
# KB AI 해커톤 - 환경변수 설정
# 이 파일을 .env 로 복사 후 실제 값 입력
# ==============================

# 소상공인시장진흥공단 상가(상권)정보 API
# https://www.data.go.kr/data/15083033/openapi.do
SMFG_API_KEY=your_smfg_api_key_here

# 공공데이터포털 - 지방행정 인허가 데이터 (개업/폐업)
# https://www.data.go.kr/data/15013352/openapi.do
PUBLIC_DATA_API_KEY=your_public_data_api_key_here

# 서울 열린데이터광장 - 생활인구 데이터
SEOUL_DATA_API_KEY=your_seoul_data_api_key_here

# 데모 모드 (실제 API 없이 사전 수집 데이터로 실행)
# true: 사전 수집 데이터 사용 / false: 실시간 API 호출
DEMO_MODE=true
